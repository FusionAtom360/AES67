[Unit]
Description=AES67 speaker control daemon
After=network-online.target aes67-ptp4l.service aes67-phc2sys.service
Wants=network-online.target aes67-ptp4l.service aes67-phc2sys.service

[Service]
Type=simple
User=aes67
Group=aes67
WorkingDirectory=/opt/aes67/current/control
EnvironmentFile=-/etc/aes67/aes67.env
ExecStart=/usr/bin/node /opt/aes67/current/control/dist/src/index.js
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/aes67 /var/lib/aes67

[Install]
WantedBy=multi-user.target
