# Copy to /etc/aes67/aes67.env and adjust for the node.
AES67_ALSA_DEVICE=default
AES67_ALSA_CAPTURE_DEVICE=default
AES67_SPEAKER_EXECUTABLE=/opt/aes67/current/build/aes67_speaker_node
AES67_STATE_FILE=/var/lib/aes67/control-state.json
CONTROL_HOST=127.0.0.1
CONTROL_PORT=8080
AES67_MEDIA_INTERFACE=eth0
AES67_DESTINATION=239.69.0.1
AES67_DESTINATION_PORT=5004
